<Project>
    <PropertyGroup>
        <BaseIntermediateOutputPath>..\build\DaocAdmin\$(Configuration)\</BaseIntermediateOutputPath>
    </PropertyGroup>
    <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
    <!-- daoc-admin: CLI for a running server. The admin screen (no arguments, in a terminal) is tui/, started by deploy/daoc-admin. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <AssemblyName>DaocAdmin</AssemblyName>
        <RootNamespace>DaocServer.Admin.Tool</RootNamespace>
        <InvariantGlobalization>true</InvariantGlobalization>
        <IntermediateOutputPath>..\build\DaocAdmin\$(Configuration)\obj\</IntermediateOutputPath>
        <OutputPath>..\$(Configuration)\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Admin.Protocol\Admin.Protocol.csproj" />
    </ItemGroup>
    <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
